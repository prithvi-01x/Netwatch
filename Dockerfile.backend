# Dockerfile.backend
# Full NetWatch backend: FastAPI, aggregation, detection engine, storage, LLM enrichment.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpcap-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt pyproject.toml /app/
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir fastapi uvicorn httpx

# Copy source code and install netwatch in editable mode
COPY netwatch/ /app/netwatch/
RUN pip install --no-cache-dir -e .

# Data volume directory for SQLite
RUN mkdir -p /data

EXPOSE 8000

CMD ["python", "-m", "netwatch.backend.main"]
